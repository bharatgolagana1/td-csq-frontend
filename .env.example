# Keycloak (realm `csq`, public client with PKCE)
VITE_KEYCLOAK_URL=https://auth.tinydata.in/
VITE_KEYCLOAK_REALM=csq
VITE_KEYCLOAK_CLIENT_ID=csq-frontend

# CSQ API base (see ../td-csq-backend/docs/ARCHITECTURE.md §6)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Public path the app is served under: '/' here, '/app/' in the production
# image (https://dev.csq.aero/app/). Vite `base` + router basename; see README.
VITE_BASE_PATH=/
